# =====================================================
# NOVA OPTIMIZER - Configuracion del servidor
# =====================================================
# Copia este archivo a ".env" y completa tus datos.
# No subas el .env a repositorios publicos.

# --- Puerto del servidor web ---
PORT=3000

# --- Base de datos MySQL (remota, opcional: solo historial) ---
DB_HOST=tuhosting.com
DB_PORT=3306
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=tu_base_de_datos

# --- Limite de subida en MB ---
MAX_FILE_MB=25

# --- Google OAuth (inicio de sesion) ---
# Crea credenciales OAuth en: https://console.cloud.google.com/apis/credentials
# 1) Tipo: "Aplicacion web" | URI de redireccion autorizada:
#    https://TU-SERVICIO.onrender.com/auth/google/callback
# 2) Copia aqui el ID y el secreto de cliente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL publica del sitio (sin barra final). En Render: https://TU-SERVICIO.onrender.com
# En desarrollo local: http://localhost:3000
OAUTH_BASE_URL=https://nova-optimizer-hldd.onrender.com
