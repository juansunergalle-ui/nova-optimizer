# =====================================================
# NOVA OPTIMIZER - Configuracion MySQL remota (hosting)
# =====================================================
# Copia este archivo a ".env" y completa tus datos.
# No subas el .env a repositorios publicos.

# --- Puerto del servidor web ---
PORT=3000

# --- Base de datos MySQL (remota) ---
DB_HOST=tuhosting.com
DB_PORT=3306
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=tu_base_de_datos

# --- Limite de subida en MB ---
MAX_FILE_MB=25
